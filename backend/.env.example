# Copy to backend/.env and fill in what you need. Every value is optional for local use.

# --- server -------------------------------------------------------------------
PORT=8787
# comma-separated browser origins allowed to call the API with cookies
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# NODE_ENV=production   # secure cookies, serves frontend/dist, stricter rate limits

# --- database -----------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database in backend/data/pg.
# For Supabase use the pooled connection string (Project → Settings → Database):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# PGLITE_DIR=pg          # relative to DATA_DIR; "memory" for a throwaway database
# DATA_DIR=data

# --- files --------------------------------------------------------------------
# STORAGE_DIR=storage
# MAX_UPLOAD_MB=500

# --- pipeline worker ------------------------------------------------------------
# WORKER_CONCURRENCY=2
# RUN_WORKER=true        # set false on API-only replicas when a separate worker runs

# --- AI -------------------------------------------------------------------------
# auto: Groq if GROQ_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else offline rules.
AI_PROVIDER=auto
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides. Defaults live in src/ai/groq.js and src/ai/openai.js, and the
# provider swaps in an available model if your account does not have the default one.
# AI_CHAT_MODEL=
# AI_VISION_MODEL=
# AI_TRANSCRIBE_MODEL=
# Optional: Qdrant for retrieval instead of pgvector
# QDRANT_URL=
# QDRANT_API_KEY=
